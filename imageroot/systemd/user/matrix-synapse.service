[Unit]
Description=Matrix synapse
After=network-online.target matrix-postgres.service
PartOf=matrix.target
ConditionPathExists=%E/state/config.json

[Service]
Type=exec
EnvironmentFile=%E/state/environment
Environment=PODMAN_SYSTEMD_UNIT=%n
WorkingDirectory=%E/state
ExecStartPre=runagent matrixctl prepare-synapse
ExecStart=runagent matrixctl run synapse
ExecStop=runagent matrixctl stop synapse
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=60
SyslogIdentifier=%u

[Install]
WantedBy=default.target
