[Unit]
Description=Matrix maubot
After=network-online.target matrix-synapse.service
PartOf=matrix.target
ConditionPathExists=%E/state/config.json

[Service]
Type=exec
EnvironmentFile=%E/state/environment
Environment=PODMAN_SYSTEMD_UNIT=%n
WorkingDirectory=%E/state
ExecStart=runagent matrixctl run maubot
ExecStop=runagent matrixctl stop maubot
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=60
SyslogIdentifier=%u

[Install]
WantedBy=default.target
