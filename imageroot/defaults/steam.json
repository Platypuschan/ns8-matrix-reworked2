{
  "network": {
    "proxy": null,
    "get_proxy_url": null,
    "displayname_template": "{{ .PersonaName }} (Steam)",
    "conversation_sync_limit": 20,
    "steam_bridge_path": "./",
    "steam_bridge_address": "localhost:50051",
    "steam_bridge_auto_start": true,
    "steam_bridge_startup_timeout": 30,
    "presence": {
      "enabled": true,
      "inactivity_timeout": 15,
      "inactivity_status": "invisible",
      "typing_resets_presence": true,
      "read_receipts_reset_presence": false
    },
    "presence_topic": {
      "enabled": false,
      "rich_presence_enabled": false,
      "show_raw_tokens": false
    }
  },
  "bridge": {
    "command_prefix": "!steam",
    "personal_filtering_spaces": true,
    "private_chat_portal_meta": true,
    "async_events": false,
    "split_portals": false,
    "resend_bridge_info": false,
    "no_bridge_info_state_key": false,
    "bridge_status_notices": "errors",
    "unknown_error_auto_reconnect": null,
    "bridge_matrix_leave": false,
    "tag_only_on_create": true,
    "only_bridge_tags": [
      "m.favourite",
      "m.lowpriority"
    ],
    "mute_only_on_create": true,
    "deduplicate_matrix_messages": false,
    "cross_room_replies": false,
    "cleanup_on_logout": {
      "enabled": false,
      "manual": {
        "private": "nothing",
        "relayed": "nothing",
        "shared_no_users": "nothing",
        "shared_has_users": "nothing"
      },
      "bad_credentials": {
        "private": "nothing",
        "relayed": "nothing",
        "shared_no_users": "nothing",
        "shared_has_users": "nothing"
      }
    },
    "relay": {
      "enabled": false,
      "admin_only": true,
      "default_relays": [],
      "message_formats": {
        "m.text": "<b>{{ .Sender.DisambiguatedName }}</b>: {{ .Message }}",
        "m.notice": "<b>{{ .Sender.DisambiguatedName }}</b>: {{ .Message }}",
        "m.emote": "* <b>{{ .Sender.DisambiguatedName }}</b> {{ .Message }}",
        "m.file": "<b>{{ .Sender.DisambiguatedName }}</b> sent a file{{ if .Caption }}: {{ .Caption }}{{ end }}",
        "m.image": "<b>{{ .Sender.DisambiguatedName }}</b> sent an image{{ if .Caption }}: {{ .Caption }}{{ end }}",
        "m.audio": "<b>{{ .Sender.DisambiguatedName }}</b> sent an audio file{{ if .Caption }}: {{ .Caption }}{{ end }}",
        "m.video": "<b>{{ .Sender.DisambiguatedName }}</b> sent a video{{ if .Caption }}: {{ .Caption }}{{ end }}",
        "m.location": "<b>{{ .Sender.DisambiguatedName }}</b> sent a location{{ if .Caption }}: {{ .Caption }}{{ end }}"
      },
      "displayname_format": "{{ .DisambiguatedName }}"
    },
    "permissions": {
      "example.com": "user"
    }
  },
  "database": {
    "type": "postgres",
    "uri": "postgres://matrix_steam_bridge:some-password@None:5432/matrix_steam_bridge?sslmode=disable",
    "max_open_conns": 5,
    "max_idle_conns": 2,
    "max_conn_idle_time": null,
    "max_conn_lifetime": null
  },
  "homeserver": {
    "address": null,
    "domain": "example.com",
    "software": "standard",
    "status_endpoint": null,
    "message_send_checkpoint_endpoint": null,
    "async_media": false,
    "websocket": false,
    "ping_interval_seconds": 0
  },
  "appservice": {
    "address": "http://matrix-steam-bridge:8080",
    "public_address": "",
    "hostname": "0.0.0.0",
    "port": 8080,
    "id": "steam",
    "bot": {
      "username": "steambot",
      "displayname": "Steam bridge bot",
      "avatar": "mxc://shadowdrake.org/EeNKAcrmByNubPwoyceQsBaN"
    },
    "ephemeral_events": true,
    "async_transactions": false,
    "as_token": null,
    "hs_token": null,
    "username_template": "steam_{{.}}"
  },
  "matrix": {
    "message_status_events": false,
    "delivery_receipts": false,
    "message_error_notices": true,
    "sync_direct_chat_list": true,
    "federate_rooms": false,
    "upload_file_threshold": 5242880
  },
  "analytics": {
    "token": null,
    "url": "https://api.segment.io/v1/track",
    "user_id": null
  },
  "provisioning": {
    "prefix": "/_matrix/provision",
    "shared_secret": "disable",
    "allow_matrix_auth": true,
    "debug_endpoints": false
  },
  "public_media": {
    "enabled": true,
    "signing_key": null,
    "expiry": 0,
    "hash_length": 32
  },
  "direct_media": {
    "enabled": false,
    "server_name": "media.example.com",
    "well_known_response": null,
    "media_id_prefix": null,
    "allow_proxy": true,
    "server_key": ""
  },
  "backfill": {
    "enabled": true,
    "max_initial_messages": 50,
    "max_catchup_messages": 500,
    "unread_hours_threshold": 720,
    "threads": {
      "max_initial_messages": 50
    },
    "queue": {
      "enabled": false,
      "batch_size": 100,
      "batch_delay": 20,
      "max_batches": -1,
      "max_batches_override": {}
    }
  },
  "double_puppet": {
    "servers": {},
    "allow_discovery": false,
    "secrets": {}
  },
  "encryption": {
    "allow": true,
    "default": true,
    "require": false,
    "appservice": false,
    "msc4190": false,
    "self_sign": false,
    "allow_key_sharing": true,
    "pickle_key": "mautrix.bridge.e2ee",
    "delete_keys": {
      "delete_outbound_on_ack": false,
      "dont_store_outbound": false,
      "ratchet_on_decrypt": false,
      "delete_fully_used_on_decrypt": false,
      "delete_prev_on_new_session": false,
      "delete_on_device_delete": false,
      "periodically_delete_expired": false,
      "delete_outdated_inbound": false
    },
    "verification_levels": {
      "receive": "unverified",
      "send": "unverified",
      "share": "cross-signed-tofu"
    },
    "rotation": {
      "enable_custom": false,
      "milliseconds": 604800000,
      "messages": 100,
      "disable_device_change_key_rotation": false
    }
  },
  "logging": {
    "min_level": "warn",
    "writers": [
      {
        "type": "stdout",
        "format": "pretty-colored"
      }
    ]
  }
}
